---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/sections/Nav.astro';
import Hero from '@/components/sections/Hero.astro';
import Label from '@/components/ui/Label.astro';
import Link from '@/components/ui/Link.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />

    <!-- Sections 02–06 are built after the styleguide review. -->
    <section id="work" class="section page-grid proof-note">
      <div class="col-content">
        <Label as="p">02 / 06 · Selected work · in progress</Label>
        <p class="small-copy">
          The rest of the poster is still on the press. Meanwhile, the full system is on the
          <Link href="/styleguide">styleguide</Link>.
        </p>
      </div>
    </section>
  </main>
</Base>

<style>
  .proof-note {
    padding-block: 4rem 6rem;
  }
  .proof-note .small-copy {
    margin-top: 0.75rem;
  }
</style>
