---
/**
 * /styleguide: every token, primitive, effect and animation of the Two-Ink Print system.
 * noindex, and excluded from the sitemap (astro.config.mjs).
 */
import Base from '@/layouts/Base.astro';
import Nav from '@/components/sections/Nav.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import Letters from '@/components/ui/Letters.astro';
import Roll from '@/components/ui/Roll.astro';
import Label from '@/components/ui/Label.astro';
import Button from '@/components/ui/Button.astro';
import Link from '@/components/ui/Link.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import CopyEmail from '@/components/ui/CopyEmail.astro';
import Count from '@/components/ui/Count.astro';
import GridGuides from '@/components/ui/GridGuides.astro';
import Circle from '@/components/primitives/Circle.astro';
import Square from '@/components/primitives/Square.astro';
import Triangle from '@/components/primitives/Triangle.astro';
import Bar from '@/components/primitives/Bar.astro';
import Stripes from '@/components/primitives/Stripes.astro';
import CropMarks from '@/components/primitives/CropMarks.astro';
import RegMark from '@/components/primitives/RegMark.astro';
import ColorBar from '@/components/primitives/ColorBar.astro';
import InkDefs from '@/components/primitives/InkDefs.astro';
import TapeSleeve from '@/components/work/TapeSleeve.astro';
import { featuredProjects } from '@/data/projects';
import { site } from '@/data/site';

const TOTAL = 10;

const tokens = [
  { token: '--paper', light: '#F1ECE2', dark: '#17130F', role: 'Page background' },
  { token: '--ink', light: '#2A1F1A', dark: '#F1ECE2', role: 'Body text, primary lines' },
  { token: '--orange', light: '#E8501A', dark: '#E8501A', role: 'Spot ink 1: shapes, display' },
  { token: '--blue', light: '#3255A4', dark: '#62A8E5', role: 'Spot ink 2: links, labels' },
  { token: '--overprint', light: '#2F1D13', dark: '#2F1D13', role: 'Orange × blue fallback' },
  { token: '--rule', light: '#B9B3A6', dark: '#4A423A', role: 'Hairlines (never text)' },
  { token: '--paper-2', light: '#E7E0D3', dark: '#211B16', role: 'Cards and sleeves' },
];

const contrast = [
  { pair: 'Ink on paper', ratio: '13.6 : 1', use: 'Everything' },
  { pair: 'Blue on paper', ratio: '6.0 : 1 (ink mode 7.3 : 1)', use: 'Text of any size, links' },
  {
    pair: 'Orange on paper',
    ratio: '3.2 : 1 (ink mode 4.9 : 1)',
    use: 'Shapes, fills, display ≥ 32px, focus rings. Never body text.',
  },
];

const scale = [
  { token: '--step-6', sample: 'Holds.', display: true },
  { token: '--step-5', sample: 'Selected work', display: true },
  { token: '--step-4', sample: 'Side B: decisions', display: true },
  { token: '--step-3', sample: 'Refresh-token rotation', display: true },
  { token: '--step-2', sample: 'Real-time, without polling', display: true },
  { token: '--step-1', sample: 'The parts you don’t see, built to hold.' },
  { token: '--step-0', sample: 'Body copy at 17–18px with a 1.6 line height.' },
  { token: '--step--1', sample: 'Small copy for one-liners and tracklists.' },
];

const widths = [62, 75, 100, 112, 125];

const fills = ['solid', 'halftone', 'halftone-fine', 'stripes', 'outline'] as const;
---

<Base title="Styleguide" description="The Two-Ink Print design system." noindex>
  <Nav />

  <main id="main">
    <!-- ── Masthead ──────────────────────────────────────────────────────── -->
    <section class="section sg-hero" aria-labelledby="sg-title">
      <div class="page-grid">
        <div class="sg-hero__sheet">
          <CropMarks offset={8} length={18} />
          <Label as="p" class="sg-hero__spec">
            Proof 02 · Styleguide · Two-ink print · v0.2
          </Label>
          <h1
            id="sg-title"
            class="display sg-hero__title ripple"
            aria-label="Two-ink print."
            data-reveal="misreg"
          >
            <Letters text="Two-ink" />
            <br />
            <Letters text="print." offset={7} />
          </h1>
          <p class="body-copy sg-hero__intro" data-reveal="fade" data-reveal-delay="0.3">
            A two-colour risograph of a Swiss poster that came to life. Orange and blue spot inks,
            their overprint, warm black, paper. Everything on this page is built from the tokens and
            primitives below. Review the look here before any real section is built.
          </p>
          <div class="sg-hero__actions">
            <Button href="/">See the hero</Button>
            <Button data-proof-open>Proof mode (P)</Button>
          </div>
          <ColorBar labels class="sg-hero__bar" />
        </div>
      </div>
    </section>

    <!-- ── 01 Colour ─────────────────────────────────────────────────────── -->
    <section class="section" aria-labelledby="sg-colour">
      <SectionHead index={1} total={TOTAL} kicker="Inks" title="Colour" id="sg-colour" />
      <div class="page-grid sg-body">
        <ul class="sg-swatches">
          {tokens.map((t) => (
            <li class="sg-swatch">
              <span class="sg-swatch__chip" style={`background: var(${t.token})`} />
              <span class="label sg-swatch__token">{t.token}</span>
              <span class="label sg-swatch__hex">
                Paper {t.light}
                <br />
                Ink {t.dark}
              </span>
              <span class="sg-swatch__role">{t.role}</span>
            </li>
          ))}
        </ul>

        <figure class="sg-overprint">
          <svg class="art" viewBox="0 0 360 200" aria-hidden="true">
            <g class="overprint">
              <Circle cx={130} cy={100} r={84} ink="orange" />
            </g>
            <g class="overprint">
              <Circle cx={230} cy={100} r={84} ink="blue" />
            </g>
          </svg>
          <figcaption class="label">
            Fig. 1 · Orange × blue. Multiply on paper, screen on ink: the third colour is the
            overprint.
          </figcaption>
        </figure>

        <table class="sg-contrast">
          <caption class="label">Measured contrast (WCAG)</caption>
          <thead>
            <tr>
              <th scope="col" class="label">
                Pair
              </th>
              <th scope="col" class="label">
                Ratio
              </th>
              <th scope="col" class="label">
                Allowed for
              </th>
            </tr>
          </thead>
          <tbody>
            {contrast.map((c) => (
              <tr>
                <th scope="row">{c.pair}</th>
                <td class="label">{c.ratio}</td>
                <td>{c.use}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <p class="body-copy sg-note">
          Proportion: about 60% paper, 30% ink, 10% spot colour (≈7% orange, 3% blue). Each section
          has one dominant spot ink.
        </p>
      </div>
    </section>

    <!-- ── 02 Type ───────────────────────────────────────────────────────── -->
    <section class="section" aria-labelledby="sg-type">
      <SectionHead index={2} total={TOTAL} kicker="Archivo + Plex Mono" title="Type" id="sg-type" />
      <div class="page-grid sg-body">
        <div class="sg-span">
          <Label as="p">Hero · Archivo 900, wdth 62, --step-hero, leading 0.85</Label>
          <p class="display display--condensed sg-hero-type" aria-hidden="true">
            Malay
            <br />
            Shikhar
            <br />
            Soni<span class="text-orange">.</span>
          </p>
        </div>

        <ol class="sg-scale sg-span">
          {scale.map((s) => (
            <li class="sg-scale__row">
              <span class="label">{s.token}</span>
              <span class:list={[s.display && 'display']} style={`font-size: var(${s.token})`}>
                {s.sample}
              </span>
            </li>
          ))}
        </ol>

        <div class="sg-col-a">
          <Label as="p" class="sg-mb">
            Body · Archivo 400 · 17–18px · 1.6 · 65ch
          </Label>
          <div class="body-copy">
            {site.bio.map((p) => (
              <p set:html={p} />
            ))}
          </div>
        </div>

        <div class="sg-col-b">
          <Label as="p" class="sg-mb">
            Labels · IBM Plex Mono · 11–13px · caps · 0.08em
          </Label>
          <ul class="sg-labels">
            <li>
              <Label>Tape 01 · 2025</Label>
            </li>
            <li>
              <Label>Side A / Overview</Label>
            </li>
            <li>
              <Label tone="blue">Fig. 2 · Request flow</Label>
            </li>
            <li>
              <Label>01 / 06</Label>
            </li>
          </ul>
        </div>

        <div class="sg-span sg-widths">
          <Label as="p" class="sg-mb">
            Width axis · Archivo wdth 62 → 125
          </Label>
          <ul>
            {widths.map((w) => (
              <li>
                <span class="label">{w}</span>
                <span class="display" style={`--wdth: ${w}`}>
                  Holds
                </span>
              </li>
            ))}
          </ul>
          <p class="sg-wdth-hover">
            <span class="display wdth-hover" data-cursor>
              Hover to widen
            </span>
          </p>
        </div>
      </div>
    </section>

    <!-- ── 03 Grid ───────────────────────────────────────────────────────── -->
    <section class="section sg-grid-section" aria-labelledby="sg-grid">
      <SectionHead index={3} total={TOTAL} kicker="12 / 4 columns" title="Grid" id="sg-grid" />
      <div class="sg-grid-demo">
        <GridGuides />
        <div class="page-grid sg-grid-demo__content">
          <Label as="p" class="sg-g-a">
            Margin · index labels · cols 1–2
          </Label>
          <p class="sg-g-b display">Content starts at column 3 or 4.</p>
          <p class="sg-g-c body-copy">
            12 columns with visible hairline guides on select sections, the way a Swiss poster shows
            its construction. Phones collapse to 4 columns but keep the asymmetry and the labels.
          </p>
        </div>
      </div>
    </section>

    <!-- ── 04 Print effects ──────────────────────────────────────────────── -->
    <section class="section" aria-labelledby="sg-print">
      <SectionHead index={4} total={TOTAL} kicker="Texture + marks" title="Print" id="sg-print" />
      <div class="page-grid sg-body">
        <div class="sg-card sg-col-a">
          <Label as="h3">Grain</Label>
          <p class="sg-small">
            One fixed feTurbulence overlay over the whole page at ~7–9%. Jitters at 8fps on desktop
            only. Below: the same grain at 6× strength for inspection.
          </p>
          <div class="sg-grain-sample">
            <div class="grain grain--sample"></div>
          </div>
        </div>

        <div class="sg-card sg-col-b">
          <Label as="h3">Halftone + stripes</Label>
          <div class="sg-fills">
            {(['blue', 'orange', 'ink'] as const).map((ink) => (
              <svg class="art" viewBox="0 0 240 80" aria-hidden="true">
                <rect x="0" y="0" width="80" height="80" fill={`url(#ht-${ink})`} />
                <rect x="80" y="0" width="80" height="80" fill={`url(#htf-${ink})`} />
                <rect x="160" y="0" width="80" height="80" fill={`url(#st-${ink})`} />
              </svg>
            ))}
          </div>
          <p class="label">ht, htf, st · blue 15°, orange 75°, ink 45°</p>
        </div>

        <div class="sg-card sg-col-a">
          <Label as="h3">Crop + registration marks</Label>
          <div class="sg-marks">
            <div class="sg-marks__box">
              <CropMarks offset={8} length={18} />
              <span class="label">Trim</span>
            </div>
            <div class="sg-marks__regs">
              <RegMark size={28} />
              <RegMark size={28} ink="blue" />
              <RegMark size={28} ink="orange" />
            </div>
          </div>
        </div>

        <div class="sg-card sg-col-b">
          <Label as="h3">Colour bar divider</Label>
          <ColorBar labels />
          <ColorBar class="sg-mt" />
        </div>
      </div>
    </section>

    <!-- ── 05 Primitives ─────────────────────────────────────────────────── -->
    <section class="section" aria-labelledby="sg-prims">
      <SectionHead
        index={5}
        total={TOTAL}
        kicker="Illustration language"
        title="Primitives"
        id="sg-prims"
      />
      <div class="page-grid sg-body">
        <div class="sg-span sg-prims">
          {fills.map((fill) => (
            <div class="sg-prims__row">
              <Label class="sg-prims__fill">{fill}</Label>
              <svg class="art" viewBox="0 0 120 120" aria-label={`Circle, ${fill}`} role="img">
                <Circle cx={60} cy={60} r={48} ink="blue" fill={fill} />
              </svg>
              <svg class="art" viewBox="0 0 120 120" aria-label={`Semicircle, ${fill}`} role="img">
                <Circle cx={60} cy={84} r={50} half="top" ink="orange" fill={fill} />
              </svg>
              <svg class="art" viewBox="0 0 120 120" aria-label={`Square, ${fill}`} role="img">
                <Square x={14} y={14} size={92} ink="ink" fill={fill} />
              </svg>
              <svg class="art" viewBox="0 0 120 120" aria-label={`Triangle, ${fill}`} role="img">
                <Triangle x={10} y={14} width={100} height={92} ink="blue" fill={fill} />
              </svg>
              <svg class="art" viewBox="0 0 120 120" aria-label={`Bar, ${fill}`} role="img">
                <Bar x={10} y={60} length={100} thickness={22} ink="orange" fill={fill} />
              </svg>
              <svg class="art" viewBox="0 0 120 120" aria-label={`Stripes, ${fill}`} role="img">
                <Stripes x={14} y={14} width={92} height={92} count={5} ink="ink" fill={fill} />
              </svg>
            </div>
          ))}
          <div class="sg-prims__row sg-prims__names" aria-hidden="true">
            <span></span>
            {['Circle', 'Circle half', 'Square', 'Triangle', 'Bar', 'Stripes'].map((n) => (
              <span class="label">{n}</span>
            ))}
          </div>
        </div>

        <figure class="sg-span sg-compo" data-drift>
          <CropMarks offset={8} length={16} tone="rule" />
          <svg class="art" viewBox="0 0 800 420" aria-hidden="true">
            <g class="overprint">
              <Stripes x={40} y={40} width={220} height={120} count={6} ink="blue" depth={0.3} />
              <Circle cx={470} cy={210} r={170} ink="blue" fill="halftone" depth={0.6} />
              <Square x={600} y={60} size={120} ink="blue" depth={0.9} />
            </g>
            <g class="overprint">
              <Circle cx={300} cy={260} r={130} half="top" ink="orange" depth={1} />
              <Bar x={150} y={300} length={560} thickness={20} ink="orange" depth={0.45} />
              <Triangle x={620} y={220} width={130} height={150} ink="orange" depth={0.75} />
            </g>
            <Bar x={40} y={380} length={720} thickness={1.5} ink="ink" />
          </svg>
          <figcaption class="label">
            Fig. 2 · Composition with hero drift: move the pointer (desktop). The overlaps, and the
            overprint, shift with each shape’s depth.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ── 06 UI ─────────────────────────────────────────────────────────── -->
    <section class="section" aria-labelledby="sg-ui">
      <SectionHead index={6} total={TOTAL} kicker="Controls" title="Interface" id="sg-ui" />
      <div class="page-grid sg-body">
        <div class="sg-card sg-col-a">
          <Label as="h3">Buttons</Label>
          <div class="sg-row">
            <Button href="#sg-ui" variant="cta">
              See selected work
            </Button>
          </div>
          <p class="sg-small">
            Large CTA only: orange wipe, paper label at 24px (large text, so 3.2:1 passes).
          </p>
          <div class="sg-row">
            <Button href={site.resume}>Résumé ↓</Button>
            <Button>Button element</Button>
          </div>
          <p class="sg-small">Smaller buttons wipe in ink instead.</p>
        </div>

        <div class="sg-card sg-col-b">
          <Label as="h3">Links</Label>
          <p class="body-copy">
            An <Link href="/styleguide#sg-type">internal link</Link> draws its underline on hover.
            An external one gets an arrow: <Link href={site.links.github}>GitHub</Link>.
          </p>
          <Label as="h3" class="sg-mt-lg">
            Focus
          </Label>
          <p class="sg-small">
            Tab through this page: every interactive element gets a 2px orange outline, 3px offset.
          </p>
        </div>

        <div class="sg-card sg-col-a">
          <Label as="h3">Theme toggle</Label>
          <ThemeToggle />
          <p class="sg-small">
            Remembers your choice; follows the OS until you choose. The new ink rolls down over the
            page.
          </p>
        </div>

        <div class="sg-card sg-col-b">
          <Label as="h3">Copy email</Label>
          <CopyEmail class="sg-copy" />
        </div>

        <div class="sg-card sg-span">
          <Label as="h3">Cursor</Label>
          <p class="sg-small">
            Desktop with a mouse only: a small ink dot follows with a slight lag and overprints in
            orange over anything clickable. The native cursor always stays.
          </p>
        </div>
      </div>
    </section>

    <!-- ── 07 Tapes ──────────────────────────────────────────────────────── -->
    <section class="section" aria-labelledby="sg-tapes">
      <SectionHead index={7} total={TOTAL} kicker="Project cards" title="Tapes" id="sg-tapes" />
      <div class="page-grid sg-body">
        <p class="sg-span sg-small">
          Hover or focus a tape: it slides out of the sleeve, the reels turn, the plates slip out of
          register. The whole card is one link.
        </p>
        <ul class="sg-span sg-tapes">
          {featuredProjects.map((project) => (
            <li>
              <TapeSleeve project={project} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── 08 Text hovers ────────────────────────────────────────────────── -->
    <section class="section" aria-labelledby="sg-text">
      <SectionHead index={8} total={TOTAL} kicker="Subtle hovers" title="Text" id="sg-text" />
      <div class="page-grid sg-body">
        <div class="sg-card sg-span">
          <Label as="h3">Pressure + plate trail · the hero name</Label>
          <p class="display sg-pressure" aria-label="Pressure" data-sg-pressure data-cursor>
            <Letters text="PRESSURE" />
          </p>
          <p class="small-copy">
            Letters swell toward the cursor on the width and weight axes; the blue and orange plates
            trail its speed. Click to stamp it out of register. On touch screens a sweep plays once
            and taps stamp.
          </p>
        </div>

        <div class="sg-card sg-col-a">
          <Label as="h3">Ripple · display headings</Label>
          <p class="display sg-ripple ripple" aria-label="Hover this heading">
            <Letters text="Hover this heading" />
          </p>
          <p class="small-copy">
            A width wave runs through the letters. Every section title has it.
          </p>
        </div>

        <div class="sg-card sg-col-b">
          <Label as="h3">Roll · nav, buttons, CTAs</Label>
          <ul class="sg-roll-demo">
            <li>
              <a class="label" href="#sg-text">
                <Roll>Work</Roll>
              </a>
            </li>
            <li>
              <a class="label" href="#sg-text">
                <Roll>About</Roll>
              </a>
            </li>
            <li>
              <a class="label" href="#sg-text">
                <Roll>Contact</Roll>
              </a>
            </li>
          </ul>
          <div class="sg-row">
            <Button>Every button rolls</Button>
          </div>
        </div>

        <div class="sg-card sg-col-a">
          <Label as="h3">Decrypt · mono labels</Label>
          <ul class="sg-labels">
            <li>
              <Label data-scramble>Tape 01 · WorkWave · 2025–26</Label>
            </li>
            <li>
              <Label data-scramble>Side B / Engineering decisions</Label>
            </li>
            <li>
              <Label tone="blue" data-scramble>
                Fig. 1 · Request flow
              </Label>
            </li>
          </ul>
          <p class="small-copy">Hover a label. Tapes decrypt their spec line when hovered.</p>
        </div>

        <div class="sg-card sg-col-b">
          <Label as="h3">Ink mark · key phrases</Label>
          <p class="body-copy">
            I gravitate to the back of the stack: <span class="ink-mark">auth flows</span>,{' '}
            <span class="ink-mark">real-time sync</span> and{' '}
            <span class="ink-mark">permission models</span>: the code that decides who is allowed to
            do what.
          </p>
        </div>

        <div class="sg-card sg-span">
          <Label as="h3">Lift · list rows</Label>
          <ul class="lift sg-lift">
            <li>Refresh-token rotation with reuse detection</li>
            <li>Refresh tokens hashed at rest (SHA-256)</li>
            <li>Closing IDOR holes</li>
            <li>Socket sessions that expire</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ── 09 Motion ─────────────────────────────────────────────────────── -->
    <section class="section" aria-labelledby="sg-motion">
      <SectionHead index={9} total={TOTAL} kicker="Every animation" title="Motion" id="sg-motion" />
      <div class="page-grid sg-body">
        <p class="sg-span sg-small">
          expo.out / power4.out for reveals, 0.6–1.2s; hovers 0.2–0.35s. One snap: the plates
          locking into registration. With reduced motion everything is shown in its final state.
        </p>

        <div class="sg-span sg-print-demo" data-reveal="print" data-print-demo id="demo-print">
          <CropMarks offset={8} length={18} />
          <svg class="art sg-print-demo__art" viewBox="0 0 600 300" aria-hidden="true">
            <g data-plate="blue" class="overprint">
              <Circle cx={380} cy={150} r={118} ink="blue" fill="halftone" />
              <Square x={64} y={52} size={120} ink="blue" />
            </g>
            <g data-plate="orange" class="overprint">
              <Circle cx={250} cy={176} r={96} ink="orange" />
              <Bar x={150} y={262} length={390} thickness={14} ink="orange" />
            </g>
          </svg>
          <div class="sg-print-demo__type">
            <p class="display display--condensed sg-print-demo__name" data-print="name">
              Print
              <br />
              run<span class="text-orange">.</span>
            </p>
            <p class="label" data-print="type">
              Plate 1 blue · plate 2 orange · in register
            </p>
          </div>
          <Label as="h3" class="sg-demo-title">
            Hero print run · 2.2s
          </Label>
          <Button data-replay="#demo-print" class="sg-replay">
            Replay
          </Button>
        </div>

        <div class="sg-card sg-col-a">
          <Label as="h3">Line reveal</Label>
          <p class="display sg-demo-head" id="demo-lines" data-reveal="lines">
            Lines rise
            <br />
            through masks
          </p>
          <Button data-replay="#demo-lines" class="sg-replay">
            Replay
          </Button>
        </div>

        <div class="sg-card sg-col-b">
          <Label as="h3">Misregistration</Label>
          <p class="display sg-demo-head" id="demo-misreg" data-reveal="misreg">
            Plates slide
            <br />
            into register
          </p>
          <Button data-replay="#demo-misreg" class="sg-replay">
            Replay
          </Button>
        </div>

        <div class="sg-card sg-col-a">
          <Label as="h3">Body fade + rise</Label>
          <p class="body-copy" id="demo-fade" data-reveal="fade">
            Body text gets a simple fade and a 10px rise, nothing more. If JavaScript never runs,
            it’s visible anyway.
          </p>
          <Button data-replay="#demo-fade" class="sg-replay">
            Replay
          </Button>
        </div>

        <div class="sg-card sg-col-b">
          <Label as="h3">Stagger</Label>
          <ul class="sg-stagger" id="demo-stagger" data-reveal="stagger">
