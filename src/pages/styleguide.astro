<script>
  import { replay, drift } from '@/scripts/motion';
  import { pressure } from '@/scripts/text';

  let undrift: (() => void)[] = [];

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-replay]').forEach((button) => {
      button.addEventListener('click', () => {
        const selector = button.dataset.replay;
        if (!selector) return;
        document.querySelectorAll<HTMLElement>(selector).forEach((el) => replay(el));
      });
    });
    document
      .querySelector('[data-proof-open]')
      ?.addEventListener('click', () => document.dispatchEvent(new Event('proof:open')));
    undrift = [...document.querySelectorAll<HTMLElement>('[data-drift]')].map((el) => drift(el));
    const demo = document.querySelector<HTMLElement>('[data-sg-pressure]');
    if (demo) {
      const p = pressure(demo, { radius: 1.3 });
      undrift.push(p.destroy);
    }
  });

  document.addEventListener('astro:before-swap', () => {
    undrift.forEach((stop) => stop());
    undrift = [];
  });
</script>

